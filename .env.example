# =============================================================================
# HyreKit — переменные окружения (шаблон). Скопируйте в .env.
# =============================================================================

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- База данных ---
DATABASE_URL=postgresql+asyncpg://hyrekit:devpassword@localhost:5432/hyrekit
DATABASE_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Авторизация ---
SECRET_KEY=change-me-to-random-64-char-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://hyrekit.ru"]

# --- GigaChat (developers.sber.ru) ---
# Ключ авторизации (Base64 client_id:client_secret). Без ключа сервис работает
# в детерминированном режиме: разбор резюме и тесты обходятся без LLM.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat

# Демо-аккаунты candidate@hyrekit.ru / employer@hyrekit.ru и 120 синтетических кандидатов
SEED_DEMO=true
CALIBRATION_INTERVAL_MINUTES=60  # мониторинг утечек заданий; 0 — выключен
GUEST_MODE=true  # экспресс-тест для жюри без регистрации
# Вход через ФСП ID (OIDC). Пустой issuer — встроенный тестовый провайдер /api/v1/fsp-id
FSP_OIDC_ISSUER=
FSP_OIDC_CLIENT_ID=hyrekit
FSP_OIDC_CLIENT_SECRET=
FSP_OIDC_MOCK=true
# Адрес фронтенда для ссылок в письмах и Swagger UI на /docs
PUBLIC_URL=http://localhost:3000
DOCS_ENABLED=true

# --- Почта: подтверждение адреса ---
# Пусто — письмо не отправляется, ссылка подтверждения пишется в лог API.
# В docker compose подставляется Mailpit (письма видны на http://localhost:8025).
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false
MAIL_FROM=HyreKit <noreply@hyrekit.ru>

# --- Файлы ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
